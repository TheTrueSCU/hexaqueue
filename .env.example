# ==============================================================================
# Hexaqueue Environment Configuration Template (.env.example)
#
# Copy this file to `.env` or `.env.local` for local development.
# IMPORTANT: Never commit `.env` or `.env.local` files to source control.
# Hexaqueue automatically discovers `.env` and `.env.local` up to the git root.
# `.env.local` takes precedence over `.env`, and shell environment variables
# (or GitHub Actions Secrets) take precedence over both.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Control-Plane Authentication (Clients & Test Runners -> Hexaqueue Server)
# ------------------------------------------------------------------------------
# When running distributed tests via pytest-hexaqueue or invoking the Hexaqueue CLI,
# only the controller endpoint and client bearer token are required. Test runners
# do NOT require any CSP cloud credentials when dispatching to a remote cluster.

HEXAQUEUE_SERVER_URL=http://127.0.0.1:8000
HEXAQUEUE_API_TOKEN=your-hexaqueue-bearer-token-here

# ------------------------------------------------------------------------------
# 2. Compute-Plane Cloud Service Provider (CSP) Credentials
#    (Required only on hexaqueue-server / workers managing cloud instances)
# ------------------------------------------------------------------------------

# --- Oracle Cloud Infrastructure (OCI) Free-Tier (4 OCPU / 24 GB RAM) ---
# Ambient Auth: If running on an OCI VM, set HEXAQUEUE_OCI_INSTANCE_PRINCIPALS=true
# and leave key credentials blank.
HEXAQUEUE_OCI_TENANCY_OCID=ocid1.tenancy.oc1..exampletenancyocid
HEXAQUEUE_OCI_USER_OCID=ocid1.user.oc1..exampleuserocid
HEXAQUEUE_OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
HEXAQUEUE_OCI_KEY_FILE=/path/to/oci_api_key.pem
HEXAQUEUE_OCI_REGION=us-ashburn-1
# Alternatively, inline key content (ideal for CI secrets):
# HEXAQUEUE_OCI_KEY_CONTENT="<paste OCI private key PEM content here>"
# Ambient Instance Principals:
# HEXAQUEUE_OCI_INSTANCE_PRINCIPALS=false

# --- Amazon Web Services (AWS) Free-Tier / EC2 ---
# Ambient Auth: If running on EC2 or GitHub Actions with OIDC, set HEXAQUEUE_AWS_USE_IAM_ROLE=true.
HEXAQUEUE_AWS_REGION=us-east-1
# HEXAQUEUE_AWS_ACCESS_KEY_ID=your-aws-access-key-id
# HEXAQUEUE_AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# HEXAQUEUE_AWS_SESSION_TOKEN=your-optional-session-token
# HEXAQUEUE_AWS_USE_IAM_ROLE=false
# HEXAQUEUE_AWS_PROFILE=default

# Standard AWS SDK fallbacks also supported automatically:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# --- Google Cloud Platform (GCP) Free-Tier / Compute Engine ---
# Ambient Auth: On GCE or GitHub Actions Workload Identity Federation (WIF), set
# HEXAQUEUE_GCP_USE_WORKLOAD_IDENTITY=true.
HEXAQUEUE_GCP_PROJECT_ID=your-gcp-project-id
HEXAQUEUE_GCP_ZONE=us-central1-a
# HEXAQUEUE_GCP_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# HEXAQUEUE_GCP_USE_WORKLOAD_IDENTITY=false

# Standard GCP SDK fallback:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Microsoft Azure Free-Tier / Virtual Machines ---
# Ambient Auth: On Azure VMs with Managed Identity, set HEXAQUEUE_AZURE_USE_MANAGED_IDENTITY=true.
# HEXAQUEUE_AZURE_TENANT_ID=your-azure-tenant-id
# HEXAQUEUE_AZURE_CLIENT_ID=your-azure-client-id
# HEXAQUEUE_AZURE_CLIENT_SECRET=your-azure-client-secret
# HEXAQUEUE_AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
# HEXAQUEUE_AZURE_RESOURCE_GROUP=hexaqueue-rg
# HEXAQUEUE_AZURE_USE_MANAGED_IDENTITY=false

# ------------------------------------------------------------------------------
# 3. Execution & Slicing Defaults
# ------------------------------------------------------------------------------
HEXAQUEUE_SLICES=4
HEXAQUEUE_FREE_TIER=true
HEXAQUEUE_POOL=default
HEXAQUEUE_FALLBACK=true
